                {
                  "id": "5a54eddb-c175-40a4-a64d-704283a9a2fe",
                  "title": "Inyección de Scripts (XSS) mediante parámetros de usuario.",
                  "status": "Open",
                  "severity": "High",
                  "type": "Tampering / Manipulación",
                  "description": "Falta de sanitización en el campo userName del login. Permite que un atacante inyecte código JS que se ejecuta en el navegador de la víctima, pudiendo robar la cookie connect.sid y suplantar al usuario legítimo.",
                  "mitigation": "- Implementar un Content Security Policy (CSP) robusto.\n\n- Sanitizar toda la salida de datos del lado del cliente.\n\n- Configurar la cookie de sesión como HttpOnly, Secure y SameSite=Lax/Strict.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 3,
                  "score": "7.1"
                }
              ],
              "trustBoundaryIds": [
