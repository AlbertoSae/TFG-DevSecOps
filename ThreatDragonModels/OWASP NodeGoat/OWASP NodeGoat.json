              "threats": [
                {
                  "id": "f849fafe-8a99-40e6-9d2d-3d19b237595c",
                  "title": "Open Redirect en recursos de aprendizaje.",
                  "status": "Open",
                  "severity": "Medium",
                  "type": "Information disclosure / Brecha de información",
                  "description": "El parámetro url en /learn no está validado contra una lista de dominios permitidos. Esto permite a un atacante redirigir a los usuarios hacia dominios externos maliciosos bajo la apariencia de un enlace oficial, facilitando campañas de phishing.",
                  "mitigation": "- Utilizar una \"lista blanca\" (allow-list) de dominios permitidos para redirecciones.\n\n- Implementar una página de advertencia intermedia antes de redirigir al usuario fuera del dominio.\n\n- Eliminar el uso de parámetros de URL dinámicos para redirecciones siempre que sea posible.",
                  "modelType": "STRIDE",
                  "new": false,
                  "number": 5,
                  "score": "4.7"
                }
